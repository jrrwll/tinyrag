GET http://{{origin}}{{api_prefix}}/dataset/list

###
GET http://{{origin}}{{api_prefix}}/dataset?id=1

###
POST http://{{origin}}{{api_prefix}}/dataset
Content-Type: application/json

{
  "name": "空白知识库",
  "description": "some description"
}

###
PUT http://{{origin}}{{api_prefix}}/dataset
Content-Type: application/json

{
  "id": 1,
  "name": "空白知识库",
  "description": "some description2",
  "process_rule": {
    "text_splitter": {
      "chunk_overlap": 50,
      "chunk_size": 256,
      "separators": [
        "\n\n",
        "\n",
        " ",
        ""
      ]
    }
  }
}

###
POST http://{{origin}}{{api_prefix}}/dataset/preview_chunk
Content-Type: application/json

{
  "file_id": "6bd6766b56467942ea6ed31875df9294",
  "process_rule": {
    "text_splitter": {
      "chunk_overlap": 50,
      "chunk_size": 256,
      "separators": [
        "\n\n",
        "\n",
        " ",
        ""
      ]
    }
  }
}

###
POST http://{{origin}}{{api_prefix}}/dataset/import
Content-Type: application/json

{
  "id": 1,
  "file": {
    "file_ids": [
      "6bd6766b56467942ea6ed31875df9294"
    ]
  }
}

###
POST http://{{origin}}{{api_prefix}}/dataset/import
Content-Type: application/json

{
  "id": 1,
  "remote_file": {
    "file_path": "chinese-poetry/quantangshi/"
  }
}