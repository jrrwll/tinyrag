GET http://{{origin}}{{api_prefix}}/knowledge/list?workspace_id=1
Authorization: Bearer {{auth_token}}

###
GET http://{{origin}}{{api_prefix}}/knowledge?id=1
Authorization: Bearer {{auth_token}}

###
# 全唐诗
POST http://{{origin}}{{api_prefix}}/knowledge
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "workspace_id": 1,
  "name": "空白知识库",
  "description": "some description"
}

###
PUT http://{{origin}}{{api_prefix}}/knowledge
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id": 1,
  "name": "全唐诗",
  "description": "资源来源：https://github.com/chinese-poetry/chinese-poetry",
  "process_rule": {
    "text_splitter": {
      "chunk_overlap": 50,
      "chunk_size": 256,
      "separators": [
        "}"
      ]
    }
  }
}

###
POST http://{{origin}}{{api_prefix}}/knowledge/preview-chunk
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "file_id": "6bd6766b56467942ea6ed31875df9294",
  "process_rule": {
    "text_splitter": {
      "chunk_overlap": 50,
      "chunk_size": 256,
      "separators": [
        "\n\n",
        "\n",
        " ",
        ""
      ]
    }
  }
}

###
POST http://{{origin}}{{api_prefix}}/knowledge/import
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id": 1,
  "file": {
    "file_ids": [
      "6bd6766b56467942ea6ed31875df9294"
    ]
  }
}

###
POST http://{{origin}}{{api_prefix}}/knowledge/import
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id": 1,
  "storage": {
    "file_path": "chinese-poetry/quantangshi/"
  }
}
