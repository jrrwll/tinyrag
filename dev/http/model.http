GET http://{{origin}}{{api_prefix}}/model/list
Authorization: Bearer {{auth_token}}

###
GET http://{{origin}}{{api_prefix}}/model?id=1
Authorization: Bearer {{auth_token}}

###
# llm text_embedding
POST http://{{origin}}{{api_prefix}}/model
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "type": "llm",
  "provider_name": "ollama",
  "model_name": "qwen3:4b",
  "config": {
    "base_url": "http://{{OLLAMA_HOST}}:11434",
    "function_calling": true
  }
}

###
PUT http://{{origin}}{{api_prefix}}/model
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id": 2,
  "model_name": "qwen3:4b",
  "config": {
    "timeout": 20
  }
}

###
POST http://{{origin}}{{api_prefix}}/model/update-enable?id=1
Authorization: Bearer {{auth_token}}

###
POST http://{{origin}}{{api_prefix}}/model/test-run
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id": 1,
  "prompt": "Who are you?"
}

###
GET http://{{origin}}{{api_prefix}}/model/default-model?model_type=llm
Authorization: Bearer {{auth_token}}

###
GET http://{{origin}}{{api_prefix}}/model/default-model?model_type=text_embedding
Authorization: Bearer {{auth_token}}

###
POST http://{{origin}}{{api_prefix}}/model/default-model
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "model_type": "llm",
  "model_id": 1
}

###
POST http://{{origin}}{{api_prefix}}/model/default-model
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "model_type": "text_embedding",
  "model_name": "all-MiniLM-L6-v2"
}