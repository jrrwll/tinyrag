###
GET {{URL_PREFIX}}/knowledge/list?workspace_id=1
Authorization: Bearer {{auth_token}}

###
GET {{URL_PREFIX}}/knowledge?id=1
Authorization: Bearer {{auth_token}}

###
# 全唐诗
POST {{URL_PREFIX}}/knowledge
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "workspace_id": 1,
  "name": "空白知识库",
  "description": "some description"
}

###
PUT {{URL_PREFIX}}/knowledge
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id": 1,
  "name": "全唐诗",
  "description": "资源来源：https://github.com/chinese-poetry/chinese-poetry"
}

###
POST {{URL_PREFIX}}/knowledge/config
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id": 1,
  "process_rule": {
    "text_splitter": {
      "type": "json_list"
    }
  }
}

###
POST {{URL_PREFIX}}/knowledge/preview-chunk
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "file_id": "{{file_id_sql}}",
  "process_rule": {
    "text_splitter": {
      "chunk_overlap": 50,
      "chunk_size": 256,
      "separators": [
        "create table"
      ]
    }
  }
}

###
POST {{URL_PREFIX}}/knowledge/preview-chunk
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "file_id": "{{file_id_json_list}}",
  "process_rule": {
    "text_splitter": {
      "type": "json_list"
    }
  }
}

###
POST {{URL_PREFIX}}/knowledge/import
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id": 1,
  "file": {
    "file_ids": [
      "{{file_id_json_list}}"
    ]
  }
}

###
POST {{URL_PREFIX}}/knowledge/import
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id": 1,
  "storage": {
    "file_path": "chinese-poetry/quantangshi/"
  }
}

> {% client.global.set("task_id", response.body.data.id); %}

###
GET {{URL_PREFIX}}/knowledge/document/list?knowledge_id=1
Authorization: Bearer {{auth_token}}

###
POST {{URL_PREFIX}}/knowledge/conversation
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "knowledge_id": 1
}

> {% client.global.set("conversation_id", response.body.data.id); %}

###
POST {{URL_PREFIX}}/knowledge/chat
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "conversation_id": "{{conversation_id}}",
  "query": "请给我三首关于江山的唐诗，以json list格式返回"
}

###
POST {{URL_PREFIX}}/knowledge/stream-chat
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "conversation_id": "{{conversation_id}}",
  "query": "请给我三首关于江山的唐诗，以json list格式返回"
}
