GET {{url_prefix}}/workspace/list
Authorization: Bearer {{auth_token}}

###
GET {{url_prefix}}/workspace?id=1
Authorization: Bearer {{auth_token}}

###
POST {{url_prefix}}/workspace
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "name": "tuke's workspace",
  "description": "test workspace"
}

###
PUT {{url_prefix}}/workspace
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id": 1,
  "name": "tuke's workspace",
  "description": "test workspace!"
}

###
POST {{url_prefix}}/workspace/config
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id": 1,
  "llm_model_config": {
    "model_id": 1,
    "temperature": 0.8
  }
}